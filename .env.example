# =============================================================================
# KB environment variables (paste into Railway → Variables → Raw Editor, or into .env locally)
# Comments stay on their own lines so every host parses the values the same way.
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- Security (required) ---
# Bearer token used by the Shortcut and the app
KB_API_TOKEN=
# Claude connector secret: https://your-domain/mcp/<KB_MCP_SECRET>
KB_MCP_SECRET=
# Public address of the app, used to build links to item pages
PUBLIC_BASE_URL=https://kb.example.com

# --- Supabase database (required) ---
# Supabase dashboard > Connect > "Session pooler" (port 5432)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- File storage: Supabase Storage (recommended) ---
SUPABASE_URL=https://<ref>.supabase.co
# "secret" key (sb_secret_…) or legacy service_role key
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=kb-files
# The Supabase free plan caps files at 50 MB
MAX_UPLOAD_MB=50

# --- Claude (required) ---
ANTHROPIC_API_KEY=
# Summaries, tags, vision: fast and cheap
ENRICH_MODEL=claude-haiku-4-5
# Default model for in-app chat answers and project briefs
CHAT_MODEL=claude-sonnet-5-5
# Models offered in the app's picker, as "id:Label,id:Label".
# Leave empty for the default list: Haiku 4.5, Sonnet 5.5, Opus 5.5, Fable 5.1
CHAT_MODELS=
# Language of summaries, tags and answers (fr, en, …)
KB_LANGUAGE=fr

# --- Voyage AI embeddings (required) ---
VOYAGE_API_KEY=
EMBED_MODEL=voyage-4
# Don't change without changing the schema (vector(1024))
EMBED_DIM=1024

# --- X / Twitter: official API (required for tweets) ---
X_BEARER_TOKEN=
# Fallback when the API doesn't return an X Article's text
X_ARTICLE_FALLBACK_FXTWITTER=true

# --- Audio/video transcription (OpenAI-compatible API) ---
# Groq (or OpenAI) key
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# With OpenAI instead: TRANSCRIPTION_BASE_URL=https://api.openai.com/v1 and TRANSCRIPTION_MODEL=whisper-1
MAX_MEDIA_MINUTES=180

# --- Notion copy (optional) ---
# A second, readable copy of your KB in a Notion database, kept up to date (see SETUP.md, step 7).
# Secret of an internal integration (notion.so/profile/integrations), starts with ntn_
NOTION_TOKEN=
# Link (or ID) of the Notion page that will hold the database; connect the integration to it first
NOTION_PARENT_PAGE_ID=
# Spaces copied to Notion: "main,perso" (everything) or "perso" (personal-development notes only)
NOTION_SPACES=main,perso

# --- Tech digest agent (optional) ---
# Every morning, a digest of the last 24 hours (general → technical) tuned to what you save in the KB;
# every Monday, the week plus project ideas. Roughly $0.10–0.20 of Claude API per day, plus the X posts read.
DIGEST_ENABLED=true
# Local hour and time zone of the daily digest
DIGEST_HOUR=7
DIGEST_TIMEZONE=Europe/Paris
# Model that writes the daily digest, and the one that writes the weekly digest and the project ideas
DIGEST_MODEL=claude-sonnet-5-5
DIGEST_WEEKLY_MODEL=claude-opus-5-5
# X posts read per day from the people you follow ($0.005 each on the pay-per-use X API; 0 = don't read X)
DIGEST_X_MAX_POSTS=50
# Optional: e-mail each digest. Google Workspace or Gmail: smtp.gmail.com, port 587, an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=

# --- Optional ---
# Residential proxy (http://user:pass@host:port) if YouTube blocks the server
YOUTUBE_PROXY_URL=
# Raises the GitHub API limit (60 requests/hour without a token)
GITHUB_TOKEN=
# Fallback for hard-to-read pages
JINA_API_KEY=
# Only if the frontend is hosted elsewhere (e.g. https://kb.netlify.app)
CORS_ORIGINS=
# Processing runs in the same service as the API
RUN_WORKER=true
WORKER_CONCURRENCY=2
