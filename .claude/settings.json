{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run dev)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(railway logs *)",
      "Bash(railway status)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
